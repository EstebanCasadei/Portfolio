---
import Button from "./Button.astro";

const EMAILJS_PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? "";
const EMAILJS_SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? "";
const EMAILJS_TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? "";
---

<section
  id="contact"
  class="panel min-h-screen relative overflow-hidden z-20 bg-bg-secondary border-t-2 border-primary/20 border-solid clamp-padding"
>
  <div class="max-w-2xl">
    <h3 class="clamp-h3 font-nohemi-bold text-primary mb-6">
      <span class="text-primary-disabled font-nohemi-medium"
        >Contame tu&nbsp;</span
      >idea<span class="text-primary-disabled font-nohemi-medium"
        >, la paso a&nbsp;</span
      ><span class="text-secondary">codigo</span>
    </h3>
  </div>

  <div class="flex flex-col w-full items-end text-right">
    <h4>
      <span class="text-xs font-nohemi-medium text-primary-disabled/50"
        >_05&nbsp;&nbsp;</span
      ><span
        class="clamp-h4 font-nohemi-medium tracking-tight text-primary-disabled/80"
        >Contacto</span
      >
    </h4>
  </div>

  <div
    class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-16 items-center mt-8 lg:mt-16"
  >
    <!-- Credencial 3D -->
    <div
      id="badge-stage"
      class="relative w-full h-[320px] sm:h-[420px] lg:h-[600px] order-1 lg:order-none touch-none select-none"
    >
      <canvas id="badge-canvas" class="w-full h-full block" aria-hidden="true"
      ></canvas>
      <p
        class="absolute bottom-2 left-1/2 -translate-x-1/2 clamp-p font-nohemi-regular text-primary-disabled/40 pointer-events-none"
      >
        Arrastrala
      </p>
    </div>

    <!-- Formulario -->
    <form
      id="contact-form"
      data-public-key={EMAILJS_PUBLIC_KEY}
      data-service-id={EMAILJS_SERVICE_ID}
      data-template-id={EMAILJS_TEMPLATE_ID}
      class="flex flex-col gap-5 w-full order-2 lg:order-none lg:justify-end justify-center"
    >
      <div class="flex flex-col gap-2">
        <label
          for="name"
          class="clamp-p font-nohemi-medium text-primary-disabled"
        >
          Nombre
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="Como te llamas"
          class="field"
        />
        <p class="field-error">Escribi tu nombre.</p>
      </div>

      <div class="flex flex-col gap-2">
        <label
          for="email"
          class="clamp-p font-nohemi-medium text-primary-disabled"
        >
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="120"
          autocomplete="email"
          placeholder="tu@correo.com"
          class="field"
        />
        <p class="field-error">Necesito un email valido para responderte.</p>
      </div>

      <div class="flex flex-col gap-2">
        <label
          for="message"
          class="clamp-p font-nohemi-medium text-primary-disabled"
        >
          Mensaje
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          minlength="10"
          maxlength="1500"
          placeholder="Contame que necesitas"
          class="field resize-y min-h-32"></textarea>
        <p class="field-error">Contame un poco mas (minimo 10 caracteres).</p>
      </div>

      <Button
        type="submit"
        variant="primary"
        size="lg"
        label="Enviar mensaje"
        class="mt-2 cursor-pointer"
      />

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="clamp-p font-nohemi-regular min-h-6"
      >
      </p>
    </form>
  </div>
</section>

<script>
  import * as THREE from "three";
  import emailjs from "@emailjs/browser";

  /* ------------------------------------------------------------------ *
   * Credencial 3D: cordon verlet + tarjeta rigida. Sin motor de fisica. *
   * ------------------------------------------------------------------ */

  const canvas = document.getElementById(
    "badge-canvas",
  ) as HTMLCanvasElement | null;
  const stage = document.getElementById("badge-stage");

  if (canvas && stage) {
    const CARD_W = 2.1;
    const CARD_H = 3.15;
    const ANCHOR = new THREE.Vector3(0, 3.4, 0);
    const ROPE_SEGMENTS = 12;
    const ROPE_LEN = 2;
    const SEG_LEN = ROPE_LEN / ROPE_SEGMENTS;
    const GRAVITY = new THREE.Vector3(0, -14, 0);
    const DAMPING = 0.985;
    const FIXED_DT = 1 / 60;
    const SOLVER_ITERATIONS = 16;
    const MAX_STRETCH = 1.01;

    // --- Escena ---
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
    camera.position.set(0, 0.8, 13);

    scene.add(new THREE.AmbientLight(0xffffff, 1.1));

    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(3, 6, 8);
    scene.add(key);

    const rim = new THREE.DirectionalLight(0x8899b3, 1.6);
    rim.position.set(-5, 2, -4);
    scene.add(rim);

    // --- Particulas ---
    type Particle = { p: THREE.Vector3; prev: THREE.Vector3; pinned: boolean };

    const make = (x: number, y: number, z: number, pinned = false): Particle => {
      const p = new THREE.Vector3(x, y, z);
      return { p, prev: p.clone(), pinned };
    };

    const rope: Particle[] = [];
    for (let i = 0; i <= ROPE_SEGMENTS; i++) {
      // Sin reduced-motion arranca hacia un costado para que caiga con swing.
      const drop = i * SEG_LEN * 0.85;
      rope.push(
        make(
          ANCHOR.x + drop,
          ANCHOR.y - i * SEG_LEN * 0.3,
          0,
          i === 0,
        ),
      );
    }
    const clip = rope[ROPE_SEGMENTS];

    // Tarjeta: 3 particulas (esquina sup. izq, sup. der, centro inferior).
    const pL = make(clip.p.x - CARD_W / 2, clip.p.y, 0);
    const pR = make(clip.p.x + CARD_W / 2, clip.p.y, 0);
    const pB = make(clip.p.x, clip.p.y - CARD_H, 0);
    const cardParts = [pL, pR, pB];

    const DIAG = Math.hypot(CARD_W / 2, CARD_H);
    // La cadena lleva ademas un clamp duro para que no se estire.
    const chain: [Particle, Particle, number][] = [];
    for (let i = 0; i < ROPE_SEGMENTS; i++)
      chain.push([rope[i], rope[i + 1], SEG_LEN]);

    const links: [Particle, Particle, number][] = [...chain];
    links.push([clip, pL, CARD_W / 2]);
    links.push([clip, pR, CARD_W / 2]);
    links.push([pL, pR, CARD_W]);
    links.push([pL, pB, DIAG]);
    links.push([pR, pB, DIAG]);
    links.push([clip, pB, CARD_H]);

    const all = [...rope, ...cardParts];

    const tmp = new THREE.Vector3();
    const grav = GRAVITY.clone().multiplyScalar(FIXED_DT * FIXED_DT);

    function step() {
      for (const q of all) {
        if (q.pinned) continue;
        tmp.subVectors(q.p, q.prev).multiplyScalar(DAMPING).add(grav);
        q.prev.copy(q.p);
        q.p.add(tmp);
      }
      for (let it = 0; it < SOLVER_ITERATIONS; it++) {
        for (const [a, b, rest] of links) {
          tmp.subVectors(b.p, a.p);
          const d = tmp.length();
          if (d < 1e-6) continue;
          tmp.multiplyScalar((d - rest) / d);
          if (a.pinned) b.p.addScaledVector(tmp, -1);
          else if (b.pinned) a.p.addScaledVector(tmp, 1);
          else {
            a.p.addScaledVector(tmp, 0.5);
            b.p.addScaledVector(tmp, -0.5);
          }
        }
      }
      rope[0].p.copy(ANCHOR);
      // Pasada final desde el ancla: el hijo se reposiciona al largo maximo.
      // Con los links ordenados de arriba hacia abajo converge en una sola pasada.
      for (const [a, b, rest] of chain) {
        tmp.subVectors(b.p, a.p);
        const d = tmp.length();
        const max = rest * MAX_STRETCH;
        if (d <= max || d < 1e-6) continue;
        b.p.copy(a.p).addScaledVector(tmp, max / d);
      }
    }

    // --- Cordon (tubo desde la curva) ---
    const curve = new THREE.CatmullRomCurve3(rope.map((q) => q.p));
    curve.curveType = "chordal";

    const cordMat = new THREE.MeshStandardMaterial({
      color: 0x262626,
      roughness: 0.75,
      metalness: 0.1,
    });
    const cord = new THREE.Mesh(new THREE.TubeGeometry(curve, 32, 0.04, 6), cordMat);
    scene.add(cord);

    // --- Tarjeta: textura desde public/img/badge-front.png ---
    // #ponytail: si la ruta cambia, solo renombrar aqui.
    const cardTexture = new THREE.TextureLoader().load("/img/badge-front.png");
    cardTexture.colorSpace = THREE.SRGBColorSpace;
    cardTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();

    const edge = new THREE.MeshStandardMaterial({
      color: 0x1a1a1a,
      roughness: 0.6,
      metalness: 0.2,
    });
    const face = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      map: cardTexture,
      roughness: 0.45,
      metalness: 0.15,
    });
    // BoxGeometry: [+x, -x, +y, -y, +z (frente), -z]
    const cardMesh = new THREE.Mesh(
      new THREE.BoxGeometry(CARD_W, CARD_H, 0.03),
      [edge, edge, edge, edge, face, edge],
    );

    const clipRing = new THREE.Mesh(
      new THREE.TorusGeometry(0.13, 0.035, 8, 20),
      new THREE.MeshStandardMaterial({
        color: 0xc9c9c9,
        roughness: 0.25,
        metalness: 0.95,
      }),
    );
    clipRing.position.set(0, CARD_H / 2 + 0.1, 0);

    const cardGroup = new THREE.Group();
    cardGroup.add(cardMesh, clipRing);
    cardGroup.matrixAutoUpdate = false;
    scene.add(cardGroup);

    const xAxis = new THREE.Vector3();
    const yDown = new THREE.Vector3();
    const yUp = new THREE.Vector3();
    const zAxis = new THREE.Vector3();
    const mid = new THREE.Vector3();
    const center = new THREE.Vector3();

    function syncCard() {
      mid.addVectors(pL.p, pR.p).multiplyScalar(0.5);
      xAxis.subVectors(pR.p, pL.p).normalize();
      yDown.subVectors(pB.p, mid).normalize();
      zAxis.crossVectors(yDown, xAxis).normalize();
      yUp.crossVectors(zAxis, xAxis).normalize();
      center.copy(mid).addScaledVector(yDown, CARD_H / 2);
      cardGroup.matrix.makeBasis(xAxis, yUp, zAxis).setPosition(center);
    }

    // --- Drag ---
    const raycaster = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    const dragPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    const hit = new THREE.Vector3();
    const grabOffset = new THREE.Vector3();
    const delta = new THREE.Vector3();
    let dragging = false;

    function pointerToPlane(e: PointerEvent, depth: number) {
      const r = canvas!.getBoundingClientRect();
      ndc.set(
        ((e.clientX - r.left) / r.width) * 2 - 1,
        -((e.clientY - r.top) / r.height) * 2 + 1,
      );
      raycaster.setFromCamera(ndc, camera);
      dragPlane.constant = -depth;
      return raycaster.ray.intersectPlane(dragPlane, hit);
    }

    canvas.addEventListener("pointerdown", (e) => {
      const r = canvas.getBoundingClientRect();
      ndc.set(
        ((e.clientX - r.left) / r.width) * 2 - 1,
        -((e.clientY - r.top) / r.height) * 2 + 1,
      );
      raycaster.setFromCamera(ndc, camera);
      if (!raycaster.intersectObject(cardMesh, false).length) return;

      if (!pointerToPlane(e, center.z)) return;
      grabOffset.subVectors(hit, center);
      dragging = true;
      canvas.setPointerCapture(e.pointerId);
      canvas.style.cursor = "grabbing";
    });

    // Alcance real del centro de la tarjeta: cordon + media tarjeta.
    const MAX_REACH = ROPE_LEN + CARD_H / 2;
    const target = new THREE.Vector3();

    canvas.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      if (!pointerToPlane(e, center.z)) return;
      // Clampear el target evita el estiron en el origen, en vez de pelearlo despues.
      target.subVectors(hit, grabOffset).sub(ANCHOR).clampLength(0, MAX_REACH).add(ANCHOR);
      delta.subVectors(target, center);
      // Mueve solo .p: la diferencia con .prev se convierte en inercia al soltar.
      for (const q of cardParts) q.p.add(delta);
    });

    const endDrag = () => {
      dragging = false;
      canvas.style.cursor = "";
    };
    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);

    // --- Resize + loop ---
    function resize() {
      const { clientWidth: w, clientHeight: h } = canvas!;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(stage);
    resize();

    let visible = false;
      let raf = 0;
      let last = performance.now();
      let acc = 0;

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      acc += Math.min((now - last) / 1000, 0.1);
      last = now;
      while (acc >= FIXED_DT) {
        step();
        acc -= FIXED_DT;
      }
      cord.geometry.dispose();
      cord.geometry = new THREE.TubeGeometry(curve, 32, 0.04, 6);
      syncCard();
      renderer.render(scene, camera);
    }

    // Pausa la simulacion cuando la seccion no esta en pantalla.
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting === visible) return;
        visible = entry.isIntersecting;
        if (visible) {
          last = performance.now();
          acc = 0;
          raf = requestAnimationFrame(frame);
        } else cancelAnimationFrame(raf);
      },
      { threshold: 0.05 },
    ).observe(stage);
  }

  /* ------------------------------- Form ------------------------------- */

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  if (form) {
    const EMAILJS_PUBLIC_KEY = form.dataset.publicKey ?? "";
    const EMAILJS_SERVICE_ID = form.dataset.serviceId ?? "";
    const EMAILJS_TEMPLATE_ID = form.dataset.templateId ?? "";

    if (EMAILJS_PUBLIC_KEY) {
      emailjs.init(EMAILJS_PUBLIC_KEY);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const button = form.querySelector("button[type=submit]") as HTMLButtonElement;

      button.disabled = true;
      status!.className = "clamp-p font-nohemi-regular min-h-6 text-primary-disabled";
      status!.textContent = "Enviando...";

      if (!EMAILJS_PUBLIC_KEY || !EMAILJS_SERVICE_ID || !EMAILJS_TEMPLATE_ID) {
        status!.className = "clamp-p font-nohemi-regular min-h-6 text-error";
        status!.textContent =
          "Faltan las credenciales de EmailJS. Revisa tu archivo .env.";
        button.disabled = false;
        return;
      }

      const formData = {
        name: (document.getElementById("name") as HTMLInputElement).value,
        email: (document.getElementById("email") as HTMLInputElement).value,
        subject: "Nuevo mensaje desde el portfolio",
        message: (document.getElementById("message") as HTMLTextAreaElement).value,
      };

      try {
        await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, formData);
        form.reset();
        status!.className = "clamp-p font-nohemi-regular min-h-6 text-success";
        status!.textContent = "Mensaje enviado. Te respondo a la brevedad.";
      } catch {
        status!.className = "clamp-p font-nohemi-regular min-h-6 text-error";
        status!.textContent =
          "No se pudo enviar. Escribime a joaquincasadei4@gmail.com";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style is:global>
  .field {
    width: 100%;
    border-radius: 1rem;
    background-color: rgba(26, 26, 26, 0.8);
    border: 1px solid rgba(247, 247, 247, 0.1);
    padding: 0.75rem 1rem;
    color: var(--color-primary);
    font-family: "Nohemi-Regular", sans-serif;
    font-size: clamp(0.75rem, calc(0.7rem + 0.25vw), 1rem);
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .field::placeholder {
    color: var(--color-primary-disabled);
    opacity: 0.5;
  }

  .field:focus {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  .field:invalid:not(:placeholder-shown) {
    border-color: var(--color-error);
  }

  .field-error {
    display: none;
    margin-top: 0.25rem;
    font-family: "Nohemi-Regular", sans-serif;
    font-size: clamp(0.75rem, calc(0.7rem + 0.25vw), 1rem);
    color: var(--color-error);
  }

  .field:invalid:not(:placeholder-shown) + .field-error {
    display: block;
  }
</style>
