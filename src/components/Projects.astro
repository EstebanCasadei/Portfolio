---
import { projects } from "../data/projects";

const cards = projects.map(
  ({ id, name, number, image, technologies, description, url }) => ({
    id,
    name,
    number,
    image,
    technologies,
    description,
    url,
  }),
);

const initialProject = projects[0];
---

<section
  id="projects"
  data-projects={JSON.stringify(cards)}
  class="panel min-h-screen relative overflow-hidden z-20 bg-bg-tertiary border-t-2 border-primary/20 border-solid flex flex-col"
>
  <div class="clamp-padding relative">
    <h3
      class="text-left sm:max-w-full max-w-[700px] ml-auto text-balance clamp-h3 font-nohemi-bold text-primary mb-6"
    >
      <span class="text-primary-disabled font-nohemi-medium"
        >Transformo tu&nbsp;</span
      >idea
      <span class="text-primary-disabled font-nohemi-regular">&nbsp;en</span
      >&nbsp;<span class="text-secondary">producto</span>
    </h3>
    <div class="flex justify-end">
      <h4>
        <span class="text-xs font-nohemi-medium text-primary-disabled/50"
          >_03&nbsp;&nbsp;</span
        ><span
          class="clamp-h4 font-nohemi-medium tracking-tight text-primary-disabled/80"
          >Proyectos</span
        >
      </h4>
    </div>
  </div>

  <div class="relative flex-1 w-full flex justify-center items-center flex-col">
    <div class="w-full xl:w-[clamp(280px,42vw,520px)]">
      <div class="pt-6 sm:pt-0 flex justify-between gap-4">
        <p
          data-project-name
          class="clamp-h3 font-nohemi-regular text-primary pb-8 xl:absolute xl:top-1/2 xl:left-0 xl:pb-0 xl:whitespace-nowrap clamp-padding-x"
        >
          {initialProject.name}
        </p>
        <p
          data-project-number
          class="clamp-h3 font-nohemi-regular text-primary-disabled pb-8 xl:absolute xl:top-1/2 xl:right-0 xl:pb-0 xl:whitespace-nowrap clamp-padding-x"
        >
          {initialProject.number}
        </p>
      </div>
      <div
        data-tech-wrapper
        class="relative overflow-hidden font-nohemi-regular text-primary w-full mb-4"
        style="min-height: 2.5rem;"
      >
        <div
          data-tech-container
          class="flex flex-wrap flex-row justify-around w-full"
        >
          {
            initialProject.technologies.map((tech) => (
              <span
                data-tech-badge
                class="flex items-center gap-2 sm:gap-3 rounded-full shadow-[inset_0_-4px_8px_-6px_rgba(0,0,0)] px-3 py-1.5 sm:p-4 sm:py-2"
              >
                {tech.icon && (
                  <img src={tech.icon} alt={tech.name} class="w-4 h-4" />
                )}

                <span class="relative z-10 text-[clamp(11px,1.8vw,16px)]">
                  {tech.name}
                </span>
              </span>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col items-center xl:!px-0 clamp-padding-x">
        <div
          class="relative w-full aspect-[4/3] sm:aspect-[16/10] sm:max-h-[45vh] xl:aspect-auto xl:max-h-none xl:w-[clamp(280px,42vw,520px)] xl:h-80"
        >
          <div
            data-project-image-container
            class="absolute isolate inset-0 w-full h-full overflow-hidden border-1 border-secondary/20 border-solid rounded-xl"
          >
            <a
              href={initialProject.url}
              target="_blank"
              data-project-icon
              class="absolute right-0 p-2 w-fit rounded-bl-lg bg-bg-tertiary text-primary font-nohemi-regular z-10"
              aria-label="Abrir proyecto"
            >
              <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg></span>
            </a>
            <a
              href={`/projects/${initialProject.id}`}
              data-project-link={initialProject.id}
              class="absolute inset-0 block"
            >
              <img
                data-project-image
                src={initialProject.image}
                alt={initialProject.name}
                class="object-cover w-full h-full"
              />
            </a>
          </div>
        </div>
        <div
          data-description-container
          class="relative overflow-hidden min-h-24 mt-4 w-full flex justify-center"
        >
          <p
            data-project-description
            class="clamp-p font-nohemi-regular text-primary max-w-xl text-center text-balance"
            set:html={initialProject.description}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  import type { Project } from "../data/projects";

  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  type ProjectCard = Pick<
    Project,
    "id" | "name" | "number" | "image" | "technologies" | "description" | "url"
  >;

  const CONFIG = {
    animation: {
      textScrambleDuration: 0.8,
      textRevealDelay: 0.2,
    },
  };

  class ProjectScroller {
    private section: HTMLElement;
    private projects!: ProjectCard[];
    private currentImage!: HTMLImageElement;
    private elements!: {
      name: HTMLElement;
      number: HTMLElement;
      techContainer: HTMLElement;
      techWrapper: HTMLElement;
      imageContainer: HTMLElement;
      image: HTMLImageElement;
      link: HTMLAnchorElement;
      icon: HTMLAnchorElement;
      description: HTMLElement;
    };

    constructor(sectionId: string) {
      this.section = document.querySelector(sectionId)!;
      if (!this.section) return;

      this.projects = JSON.parse(this.section.dataset.projects || "[]");
      this.elements = this.cacheElements();
      this.elements.image.dataset.projectId = this.projects[0].id.toString();
      this.elements.name.dataset.currentId = this.projects[0].id.toString();

      this.currentImage = this.elements.image;
      this.elements.image.style.transition = "filter 0.1s ease";
      this.projects.slice(1).forEach((project) => this.createLink(project));
      this.elements.link.addEventListener("mouseenter", () =>
        this.handleImageHover(this.elements.image),
      );
      this.elements.link.addEventListener("mouseleave", () =>
        this.handleImageLeave(this.elements.image),
      );
      this.elements.icon.addEventListener("mouseenter", () =>
        this.handleImageHover(this.currentImage),
      );
      this.elements.icon.addEventListener("mouseleave", () =>
        this.handleImageLeave(this.currentImage),
      );

      this.init();
    }

    private cacheElements() {
      return {
        name: this.section.querySelector("[data-project-name]") as HTMLElement,
        number: this.section.querySelector(
          "[data-project-number]",
        ) as HTMLElement,
        techContainer: this.section.querySelector(
          "[data-tech-container]",
        ) as HTMLElement,
        techWrapper: this.section.querySelector(
          "[data-tech-wrapper]",
        ) as HTMLElement,
        imageContainer: this.section.querySelector(
          "[data-project-image-container]",
        ) as HTMLElement,
        image: this.section.querySelector(
          "[data-project-image]",
        ) as HTMLImageElement,
        link: this.section.querySelector(
          "[data-project-link]",
        ) as HTMLAnchorElement,
        icon: this.section.querySelector("[data-project-icon]") as HTMLAnchorElement,
        description: this.section.querySelector(
          "[data-project-description]",
        ) as HTMLElement,
      };
    }

    private init() {
      if (this.projects.length <= 1) return;
      ScrollTrigger.create({
        trigger: this.section,
        start: "top top",
        end: () => `+=${window.innerHeight * (this.projects.length - 1)}`,
        pin: true,
        scrub: true,
        onUpdate: (self) => this.handleScroll(self.progress),
      });
    }

    private handleScroll(progress: number) {
      const totalProjects = this.projects.length;

      const continuousIndex = progress * (totalProjects - 1);

      if (continuousIndex >= totalProjects - 1) {
        const lastProject = this.projects[totalProjects - 1];

        // Crea la imagen del ultimo proyecto si no existe (p.ej. al
        // volver directo al ultimo desde el detalle) y activa su capa.
        this.updateImageProgress(lastProject, lastProject, 1);

        if (
          this.elements.name.dataset.currentId !== lastProject.id.toString()
        ) {
          this.scrambleToProject(lastProject);
        }

        return;
      }

      const fromIndex = Math.floor(continuousIndex);
      const toIndex = fromIndex + 1;
      const localProgress = continuousIndex - fromIndex;

      this.animateTransition(fromIndex, toIndex, localProgress);
    }

    private animateTransition(
      fromIndex: number,
      toIndex: number,
      progress: number,
    ) {
      const fromProject = this.projects[fromIndex];
      const toProject = this.projects[toIndex];

      const imageProgress = progress;
      this.updateImageProgress(fromProject, toProject, imageProgress);

      const shouldShowToProject = progress >= 0.8;
      const targetProject = shouldShowToProject ? toProject : fromProject;

      const currentTextId = this.elements.name.dataset.currentId;
      if (currentTextId !== targetProject.id.toString()) {
        this.scrambleToProject(targetProject);
      }
    }

    private updateImageProgress(
      fromProject: ProjectCard,
      toProject: ProjectCard,
      progress: number,
    ) {
      let fromLink = this.elements.imageContainer.querySelector(
        `[data-project-link="${fromProject.id}"]`,
      ) as HTMLAnchorElement;
      let toLink = this.elements.imageContainer.querySelector(
        `[data-project-link="${toProject.id}"]`,
      ) as HTMLAnchorElement;

      if (!fromLink) {
        fromLink = this.createLink(fromProject);
      }

      if (!toLink) {
        // Re-query: si from===to, createLink ya lo agrego arriba.
        toLink = this.elements.imageContainer.querySelector(
          `[data-project-link="${toProject.id}"]`,
        ) as HTMLAnchorElement;
      }
      if (!toLink) {
        toLink = this.createLink(toProject);
      }

      const fromImage = fromLink.querySelector("img") as HTMLImageElement;
      const toImage = toLink.querySelector("img") as HTMLImageElement;
      const allLinks = this.elements.imageContainer.querySelectorAll(
        "a[data-project-link]",
      );

      gsap.set(allLinks, {
        clipPath: "inset(100% 0 0 0)",
        pointerEvents: "none",
        zIndex: 0,
      });
      gsap.set(fromLink, {
        clipPath: "inset(0% 0 0 0)",
        pointerEvents: "auto",
        zIndex: 1,
      });
      gsap.set(toLink, {
        clipPath: `inset(${(1 - progress) * 100}% 0 0 0)`,
        pointerEvents: progress >= 0.5 ? "auto" : "none",
        zIndex: 2,
      });

      this.elements.icon.href =
        progress >= 0.5 ? toProject.url : fromProject.url;
      this.currentImage =
        (progress >= 0.5 ? toImage : fromImage) || this.currentImage;
    }

    private createLink(project: ProjectCard): HTMLAnchorElement {
      const link = document.createElement("a");
      link.href = `/projects/${project.id}`;
      link.dataset.projectLink = project.id.toString();
      link.className = "absolute inset-0 block";
      link.style.clipPath = "inset(100% 0 0 0)";
      link.style.pointerEvents = "none";

      const img = document.createElement("img");
      img.src = project.image;
      img.alt = project.name;
      img.className = this.elements.image.className;
      img.dataset.projectId = project.id.toString();
      img.style.transition = "filter 0.1s ease";

      link.appendChild(img);
      link.addEventListener("mouseenter", () => this.handleImageHover(img));
      link.addEventListener("mouseleave", () => this.handleImageLeave(img));

      this.elements.imageContainer.appendChild(link);
      return link;
    }

    private handleImageHover(hoveredImage: HTMLImageElement) {
      const allImages = this.elements.imageContainer.querySelectorAll("img");
      allImages.forEach((img) => {
        if (img !== hoveredImage) {
          gsap.to(img, { filter: "brightness(0.3)", duration: 0.3 });
        }
      });
    }

    private handleImageLeave(hoveredImage: HTMLImageElement) {
      const allImages = this.elements.imageContainer.querySelectorAll("img");
      allImages.forEach((img) => {
        gsap.to(img, { filter: "brightness(1)", duration: 0.3 });
      });
    }

    private scrambleToProject(targetProject: ProjectCard) {
      this.elements.name.dataset.currentId = targetProject.id.toString();
      this.elements.icon.href = targetProject.url;
      gsap.killTweensOf([this.elements.name, this.elements.number]);

      gsap.to(this.elements.name, {
        scrambleText: {
          text: targetProject.name,
          chars: "upperAndLowerCase",
          revealDelay: CONFIG.animation.textRevealDelay,
          tweenLength: false,
        },
        duration: CONFIG.animation.textScrambleDuration,
      });

      gsap.to(this.elements.number, {
        scrambleText: {
          text: targetProject.number,
          chars: "0123456789",
          revealDelay: CONFIG.animation.textRevealDelay,
          tweenLength: false,
        },
        duration: CONFIG.animation.textScrambleDuration,
      });

      this.slideTechnologies(targetProject.technologies);
      this.slideDescription(targetProject.description);
    }

    private slideTechnologies(
      newTechnologies: { name: string; icon?: string }[],
    ) {
      const currentTech = this.elements.techContainer;
      gsap.killTweensOf(currentTech);
      currentTech.innerHTML = newTechnologies
        .map(
          (tech) => `
          <span
            data-tech-badge
            class="flex items-center gap-2 sm:gap-3 rounded-full shadow-[inset_0_-4px_8px_-6px_rgba(0,0,0)] px-3 py-1.5 sm:p-4 sm:py-2"
          >

      ${
        tech.icon
          ? `
          <img src="${tech.icon}" alt="${tech.name}" class="w-4 h-4" />
      `
          : ""
      }
      <span class="relative z-10 text-[clamp(11px,1.8vw,16px)]">${tech.name}</span>
    </span>
  `,
        )
        .join("");

      this.elements.techWrapper.style.height = `${currentTech.offsetHeight}px`;
      gsap.fromTo(
        currentTech,
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" },
      );
    }

    private slideDescription(newDescription: string) {
      const currentDesc = this.elements.description;
      gsap.killTweensOf(currentDesc);
      currentDesc.innerHTML = newDescription;
      gsap.fromTo(
        currentDesc,
        { y: 40, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" },
      );
    }
  }
  const w = window as any;

  w.__initProjects = () => {
    new ProjectScroller("#projects");

    // Al volver desde un detalle, dejar el scroller posicionado en el
    // proyecto desde el que se entro (como si solo se hubiera scrolleado).
    const pid = w.__returnToProject;
    w.__returnToProject = null;
    if (!pid) return;

    const section = document.querySelector<HTMLElement>("#projects");
    if (!section) return;

    const list = JSON.parse(section.dataset.projects || "[]");
    const index = list.findIndex((p: any) => String(p.id) === String(pid));
    if (index <= 0) return;

    // Progreso del pin: el proyecto i se muestra a innerHeight * i
    // desde el inicio de la seccion.
    const y =
      section.getBoundingClientRect().top +
      window.scrollY +
      window.innerHeight * index;

    const lenis = w.lenis;
    if (lenis) {
      lenis.scrollTo(y, { immediate: true });
    } else {
      window.scrollTo({ top: y, behavior: "instant" });
    }
    // Marcar antes del refresh: evita que el scroll por hash del
    // index (/#projects) pise esta restauracion segun el orden.
    w.__scrollRestored = true;
    ScrollTrigger.refresh();
  };

  if (!w.__projectsBound) {
    w.__projectsBound = true;

    // Se dispara en la carga inicial y en cada navegacion con ClientRouter.
    document.addEventListener("astro:page-load", () => {
      w.__initProjects();
    });
  }
</script>
