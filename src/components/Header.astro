---
const navLinks = [
  { num: "_01", label: "Inicio", href: "#hero" },
  { num: "_02", label: "Filosofia", href: "#about" },
  { num: "_03", label: "Proyectos", href: "#projects" },
  { num: "_04", label: "Stack", href: "#stack" },
  { num: "_05", label: "Contacto", href: "#contact" },
];

const socialLinks = [
  { label: "Github", href: "https://github.com/EstebanCasadei", external: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/esteban-casadei-087553357/", external: true },
  { label: "Email", href: "mailto:joaquincasadei4@gmail.com", external: false },
  { label: "CV", href: "/cv/EstebanCasadeiCV.pdf", external: true },
];
---

<div
  id="scroll-progress"
  class="fixed top-0 left-0 w-0 h-[3px] bg-secondary z-100001 pointer-events-none transition-all duration-75"
>
</div>

<button
  id="menu-toggle"
  aria-expanded="false"
  aria-label="Abrir menú"
  class="fixed top-6 right-6 z-100000 w-12 h-12 rounded-full bg-neutral-950 border border-white/10 flex items-center justify-center cursor-pointer shadow-lg hover:scale-105 active:scale-95 transition-all duration-300 group"
>
  <div class="relative w-6 h-4">
    <div
      id="menu-line-1"
      class="absolute left-0 top-0 w-6 h-[2px] bg-white rounded-full origin-center"
    >
    </div>
    <div
      id="menu-line-2"
      class="absolute left-0 top-[7px] w-6 h-[2px] bg-white rounded-full origin-center"
    >
    </div>
    <div
      id="menu-line-3"
      class="absolute left-0 bottom-0 w-6 h-[2px] bg-white rounded-full origin-center"
    >
    </div>
  </div>
</button>

<div
  id="menu-overlay"
  class="fixed inset-0 bg-black/45 backdrop-blur-[10px] z-99998 pointer-events-none opacity-0 invisible"
>
</div>

<div
  id="menu-panel"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  style="visibility: hidden; transform: translateX(100%);"
  class="fixed right-0 top-0 h-dvh w-full sm:w-[360px] md:w-[420px] bg-neutral-950/80 backdrop-blur-2xl border-l border-white/5 shadow-2xl z-99999 flex flex-col justify-between overflow-hidden"
>
  <nav class="flex flex-col gap-6 mt-32 px-8 sm:px-12">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="menu-link group flex items-baseline gap-4 text-neutral-400 hover:text-white transition-colors duration-300"
        >
          <span class="text-xs font-nohemi-medium text-neutral-500 tracking-wider transition-colors duration-300 group-hover:text-white">
            {link.num}
          </span>
          <span class="text-4xl sm:text-5xl font-nohemi-medium tracking-tight transform group-hover:translate-x-2 transition-transform duration-300">
            {link.label}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="mt-auto px-8 sm:px-12 pb-12">
    <p
      class="text-xs font-nohemi-medium text-neutral-600 uppercase tracking-widest mb-4"
    >
      Redes
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="social-link text-sm font-nohemi-medium text-neutral-400 hover:text-white transition-colors duration-300 hover:underline underline-offset-4"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const toggleBtn = document.getElementById("menu-toggle");
  const overlay = document.getElementById("menu-overlay");
  const panel = document.getElementById("menu-panel");

  const line1 = document.getElementById("menu-line-1");
  const line2 = document.getElementById("menu-line-2");
  const line3 = document.getElementById("menu-line-3");

  const menuLinks = document.querySelectorAll(".menu-link");
  const socialLinks = document.querySelectorAll(".social-link");

  if (toggleBtn && overlay && panel && line1 && line2 && line3) {
    const tl = gsap.timeline({
      paused: true,
      defaults: { ease: "power4.out" },
    });

    tl.to(overlay, { autoAlpha: 1, duration: 0.4 }, 0)
      .set(panel, { visibility: "visible" }, 0)
      .fromTo(panel, { x: "100%" }, { x: "0%", duration: 0.6 }, 0)

      .to(line1, { y: 7, rotate: 45, duration: 0.4 }, 0)
      .to(line2, { scaleX: 0, opacity: 0, duration: 0.3 }, 0)
      .to(line3, { y: -7, rotate: -45, duration: 0.4 }, 0)

      .fromTo(
        menuLinks,
        {
          y: 30,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.4,
          stagger: 0.08,
        },
        "-=0.3",
      )
      .fromTo(
        socialLinks,
        {
          y: 20,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.3,
          stagger: 0.05,
        },
        "-=0.2",
      );

    let isOpen = false;

    const toggleMenu = (open: boolean) => {
      isOpen = open;

      toggleBtn.setAttribute("aria-expanded", String(isOpen));
      panel.setAttribute("aria-hidden", String(!isOpen));

      if (isOpen) {
        document.body.style.overflow = "hidden";
        const lenis = (window as any).lenis;
        if (lenis) {
          lenis.stop();
        }

        gsap.set(panel, { visibility: "visible" });
        tl.play();
      } else {
        document.body.style.overflow = "";
        const lenis = (window as any).lenis;
        if (lenis) {
          lenis.start();
        }

        // Fast but smooth closing animation
        const closeTl = gsap.timeline({
          onComplete: () => {
            gsap.set(panel, { visibility: "hidden" });
            tl.pause(0);
          }
        });

        closeTl
          .to(menuLinks, { y: 20, opacity: 0, duration: 0.2, ease: "power2.in" }, 0)
          .to(socialLinks, { y: 15, opacity: 0, duration: 0.2, ease: "power2.in" }, 0)
          .to(overlay, { autoAlpha: 0, duration: 0.25, ease: "power2.in" }, 0.1)
          .to(panel, { x: "100%", duration: 0.35, ease: "power2.in" }, 0.1)
          .to(line1, { y: 0, rotate: 0, duration: 0.25, ease: "power2.in" }, 0)
          .to(line2, { scaleX: 1, opacity: 1, duration: 0.25, ease: "power2.in" }, 0)
          .to(line3, { y: 0, rotate: 0, duration: 0.25, ease: "power2.in" }, 0);
      }
    };

    toggleBtn.addEventListener("click", () => {
      toggleMenu(!isOpen);
    });

    overlay.addEventListener("click", () => {
      if (isOpen) toggleMenu(false);
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        toggleMenu(false);
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        isOpen &&
        !panel.contains(target) &&
        !toggleBtn.contains(target) &&
        target !== overlay
      ) {
        toggleMenu(false);
      }
    });

    menuLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (href) {
          e.preventDefault();

          toggleMenu(false);

          setTimeout(() => {
            if (href.startsWith("#")) {
              const targetEl = document.querySelector(href);
              if (targetEl) {
                const lenis = (window as any).lenis;
                if (lenis) {
                  lenis.scrollTo(href);
                } else {
                  targetEl.scrollIntoView({ behavior: "smooth" });
                }
              }
            } else {
              window.location.href = href;
            }
          }, 600);
        }
      });
    });
  }

  const progressBar = document.getElementById("scroll-progress");
  if (progressBar) {
    window.addEventListener(
      "scroll",
      () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const progress =
          scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        progressBar.style.width = `${progress}%`;
      },
      { passive: true },
    );
  }
</script>
