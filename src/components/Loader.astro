<div
  id="loader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-bg-primary"
  style="transition: opacity 0.6s ease;"
>
  <p
    id="loader-percent"
    class="mt-6 font-nohemi-medium text-secondary text-[clamp(1rem,2vw,1.5rem)] tabular-nums"
  >
    0%
  </p>
</div>

<style is:global>
  html.is-loading {
    overflow: hidden;
  }
</style>

<!-- La logica vive en Layout.astro: al estar en todas las paginas,
     su listener de astro:after-swap sobrevive a las view transitions
     y elimina este markup cuando el index lo reinserta. -->
