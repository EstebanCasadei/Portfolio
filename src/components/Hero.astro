---
import GooeyText from "./GooeyText.astro";
---

<main
  id="hero"
  class="panel relative min-h-screen overflow-hidden inset-0 z-10 flex flex-col justify-center items-center
  bg-bg-primary
  bg-[radial-gradient(circle_at_97%_4%,#1c1c1c,transparent_50%),radial-gradient(circle_at_9.3%_93.2%,#1c1c1c,transparent_50%),radial-gradient(circle_at_49.9%_50%,#2e2e2e,transparent_50%)]
  [background-blend-mode:difference]"
>
  <!-- GRID BG -->

  <div id="grid-container" class="absolute inset-0 pointer-events-none">
    <!-- Grid -->
    <div
      class="absolute inset-0 opacity-[0.07]
        bg-[linear-gradient(rgba(167,139,250,.35)_1px,transparent_1px),linear-gradient(90deg,rgba(167,139,250,.35)_1px,transparent_1px)]
        bg-[length:48px_48px]"
    >
    </div>

    <!-- Grid glowing -->
    <div
      id="grid-highlight"
      class="absolute inset-0
  bg-[linear-gradient(color-mix(in_srgb,var(--color-secondary)_20%,transparent)_1px,transparent_1px),linear-gradient(90deg,color-mix(in_srgb,var(--color-secondary)_20%,transparent)_1px,transparent_1px)]
  bg-[length:48px_48px]
  [mask-image:radial-gradient(circle_260px_at_50%_50%,black_0%,rgba(0,0,0,.9)_40%,transparent_100%)]
  [-webkit-mask-image:radial-gradient(circle_260px_at_50%_50%,black_0%,rgba(0,0,0,.9)_40%,transparent_100%)]"
    >
    </div>
  </div>

  <!-- HERO -->

  <div
    class="relative z-20 text-primary font-dirty clamp-h1 text-center mt-[clamp(0rem,8vw,6rem)]"
  >
    <div id="gooey">
      <GooeyText
        textClass="block font-nohemi-medium mb-[clamp(4rem,8vw,6rem)] text-secondary text-[clamp(2rem,5vw,4rem)]"
        texts={["Developer", "Frontend", "UX/UI", "Designer", "Freelancer"]}
      />
    </div>
    <div class="pt-3 overflow-hidden flex flex-col items-center">
      <h1>
        estEban<br />
      </h1>
      <h1>caSaDei</h1>
    </div>
  </div>

  <h2
    class="absolute bottom-12 left-12 z-20 overflow-hidden
    text-primary font-nohemi-medium clamp-h2"
  >
    <span class="text-error font-nohemi-regular">-</span> plantillas
    <br />
    <span class="text-success font-nohemi-regular">+</span> personalidad
  </h2>

  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
    <div
      class="w-6 h-10 border-2 border-primary/30 rounded-full flex justify-center"
    >
      <div class="w-1 h-3 bg-primary/20 rounded-full mt-2 animate-pulse"></div>
    </div>
  </div>
</main>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  const h1 = document.querySelectorAll("#hero h1");
  const h2 = document.querySelectorAll("#hero h2");
  const gooey = document.querySelector("#gooey");

  const tl = gsap.timeline();

  if (h1) {
    const splitH1 = SplitText.create(h1, {
      type: "lines",
      linesClass: "line",
    });

    tl.from(splitH1.lines, {
      yPercent: 500,
      opacity: 1,
      duration: 1,
      stagger: 0.5,
      ease: "power4.out",
    });
  }
  if (gooey) {
    tl.from(gooey, {
      opacity: 0,
      duration: 0.2,
      stagger: 0,
      ease: "power4.out",
    });
  }
  if (h2) {
    const splitH2 = SplitText.create(h2, {
      type: "lines",
      linesClass: "line",
    });
    tl.from(splitH2.lines, {
      xPercent: -100,
      opacity: 1,
      duration: 1,
      stagger: 0.3,
      ease: "power4.out",
    });
  }
  const highlight = document.getElementById("grid-highlight");
  const gridContainer = document.getElementById("grid-container");

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;

  let x = mouseX;
  let y = mouseY;

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function animateGrid() {
    x += (mouseX - x) * 0.08;
    y += (mouseY - y) * 0.08;

    const mask = `
      radial-gradient(
        circle 260px at ${x}px ${y}px,
        black 0%,
        rgba(0,0,0,.95) 35%,
        transparent 100%
      )
    `;

    highlight!.style.maskImage = mask;
    highlight!.style.webkitMaskImage = mask;
    requestAnimationFrame(animateGrid);
  }

  animateGrid();

  window.addEventListener("mousemove", (e) => {
    const px = (e.clientX / window.innerWidth - 0.5) * 20;
    const py = (e.clientY / window.innerHeight - 0.5) * 20;

    gsap.to(gridContainer, {
      x: px,
      y: py,
      duration: 1.2,
      ease: "power3.out",
      overwrite: true,
    });
  });
</script>
