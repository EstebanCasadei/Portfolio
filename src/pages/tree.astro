---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="relative min-h-screen overflow-hidden inset-0 z-10 flex flex-col justify-center items-center
    bg-bg-primary
    bg-[radial-gradient(circle_at_97%_4%,#1c1c1c,transparent_50%),radial-gradient(circle_at_9.3%_93.2%,#1c1c1c,transparent_50%),radial-gradient(circle_at_49.9%_50%,#2e2e2e,transparent_50%)]
    [background-blend-mode:difference]"
  >
    <!-- GRID BG -->
    <div id="grid-container" class="absolute inset-0 pointer-events-none">
      <!-- Grid -->
      <div
        class="absolute inset-0 opacity-[0.07]
          bg-[linear-gradient(rgba(167,139,250,.35)_1px,transparent_1px),linear-gradient(90deg,rgba(167,139,250,.35)_1px,transparent_1px)]
          bg-[length:48px_48px]"
      >
      </div>

      <!-- Grid glowing -->
      <div
        id="grid-highlight"
        class="absolute inset-0
          bg-[linear-gradient(color-mix(in_srgb,var(--color-secondary)_20%,transparent)_1px,transparent_1px),linear-gradient(90deg,color-mix(in_srgb,var(--color-secondary)_20%,transparent)_1px,transparent_1px)]
          bg-[length:48px_48px]
          [mask-image:radial-gradient(circle_260px_at_50%_50%,black_0%,rgba(0,0,0,.9)_40%,transparent_100%)]
          [-webkit-mask-image:radial-gradient(circle_260px_at_50%_50%,black_0%,rgba(0,0,0,.9)_40%,transparent_100%)]"
      >
      </div>
    </div>
    <div class="relative z-20 flex flex-col items-center gap-8 px-4">
      <div
        class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden border-2 border-secondary/30"
      >
        <img
          src="/img/Perfil.webp"
          alt="Esteban Casadei"
          class="w-full h-full object-cover object-top"
        />
      </div>

      <!-- Name -->
      <div class="gap-0">
        <h1 class="text-primary font-dirty text-3xl md:text-4xl text-center">
          estEban caSaDei
        </h1>
        <h2 class="text-transparent [-webkit-text-stroke:1px_var(--color-primary)] font-dirty text-4xl md:text-5xl text-center">frOntEnd</h2>
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-4 w-full max-w-xs">
        <a
          href="https://estebancasadei.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex items-center justify-between overflow-hidden bg-bg-tertiary hover:bg-bg-quaternary border border-secondary/20 hover:border-secondary/50 rounded-lg px-6 py-4 transition-all duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-primary-disabled)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-briefcase"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -9"
            ></path><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"
            ></path><path d="M12 12l0 .01"></path><path
              d="M3 13a20 20 0 0 0 18 0"></path></svg
          >
          <span
            class="relative z-10 text-primary font-nohemi-medium text-lg text-center block"
          >
            Portfolio
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-primary-disabled)"
            stroke-width="2"
            stroke-linecap="round"
