<script>
  const highlight = document.getElementById("grid-highlight");
  const gridContainer = document.getElementById("grid-container");

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;

  let x = mouseX;
  let y = mouseY;

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function animateGrid() {
    x += (mouseX - x) * 0.08;
    y += (mouseY - y) * 0.08;

    const mask = `
      radial-gradient(
        circle 260px at ${x}px ${y}px,
        black 0%,
        rgba(0,0,0,.95) 35%,
        transparent 100%
      )
    `;

    highlight!.style.maskImage = mask;
    highlight!.style.webkitMaskImage = mask;
    requestAnimationFrame(animateGrid);
  }

  animateGrid();

  window.addEventListener("mousemove", (e) => {
    const px = (e.clientX / window.innerWidth - 0.5) * 20;
    const py = (e.clientY / window.innerHeight - 0.5) * 20;
  });
</script>
